pipeline {
    agent any

    environment {
        IMAGE_NAME     = "siddhant2812/flaskapp:latest"
        CONTAINER_NAME = "flaskapp"
        HOST_PORT      = "80"
        CONTAINER_PORT = "5000"
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Siddhantkadam28/terraform.git'
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                    echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" --password-stdin
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                echo "Building Docker image..."
                docker build -t $IMAGE_NAME .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                sh '''
                echo "Pushing Docker image to Docker Hub..."
                docker push $IMAGE_NAME
                '''
            }
        }

        stage('Cleanup Existing Container on Port 80') {
            steps {
                sh '''
                echo "Checking for containers using port ${HOST_PORT}..."

                CONTAINERS=$(docker ps -q --filter "publish=${HOST_PORT}")

                if [ -n "$CONTAINERS" ]; then
                    echo "Stopping containers on port ${HOST_PORT}..."
                    docker stop $CONTAINERS
                    docker rm $CONTAINERS
                else
                    echo "No containers using port ${HOST_PORT}"
                fi
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh '''
                echo "Starting new container..."
                docker run -d \
                    --name ${CONTAINER_NAME} \
                    -p ${HOST_PORT}:${CONTAINER_PORT} \
                    $IMAGE_NAME
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                echo "Waiting for application to start..."
                sleep 5
                curl -f http://localhost || exit 1
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        failure {
            echo "❌ Pipeline failed — check logs"
        }
    }
}
