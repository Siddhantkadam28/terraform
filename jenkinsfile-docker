pipeline {
    agent any

    environment {
        IMAGE_NAME     = "siddhant2812/flaskapp:latest"
        HOST_PORT      = "80"
        CONTAINER_PORT = "5000"
    }

    stages {

        stage('Checkout Source Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Siddhantkadam28/terraform.git'
            }
        }

        stage('Login to Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $IMAGE_NAME .'
            }
        }

        stage('Push Docker Image') {
            steps {
                sh 'docker push $IMAGE_NAME'
            }
        }

        stage('Cleanup Existing Container & Image on Port 80') {
            steps {
                sh '''
                echo "Checking for containers using port ${HOST_PORT}..."

                CONTAINER_IDS=$(docker ps -q --filter "publish=${HOST_PORT}")

                if [ -n "$CONTAINER_IDS" ]; then
                    echo "Container(s) found on port ${HOST_PORT}"

                    IMAGE_MATCHING_CONTAINERS=$(docker ps -q \
                        --filter "publish=${HOST_PORT}" \
                        --filter "ancestor=${IMAGE_NAME}")

                    if [ -n "$IMAGE_MATCHING_CONTAINERS" ]; then
                        echo "Matching container(s) using image ${IMAGE_NAME} found. Cleaning up..."

                        docker stop $IMAGE_MATCHING_CONTAINERS
                        docker rm   $IMAGE_MATCHING_CONTAINERS

                        echo "Removing image ${IMAGE_NAME}"
                        docker rmi ${IMAGE_NAME} || true
                    else
                        echo "Containers on port ${HOST_PORT} are NOT using image ${IMAGE_NAME}. Skipping image cleanup."
                    fi
                else
                    echo "No containers running on port ${HOST_PORT}. Skipping cleanup."
                fi
                '''
            }
        }

        stage('Run Docker Container') {
            steps {
                sh 'docker run -itd -p ${HOST_PORT}:${CONTAINER_PORT} $IMAGE_NAME'
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully "
        }
        failure {
            echo "Pipeline failed  — check logs"
        }
    }
}
